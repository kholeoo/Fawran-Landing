# Copy to .env.local for local dev, or set these in the Vercel project settings.
# Every value here is optional — the app runs without them and each feature stays
# dormant until its variable is provided.

# Canonical site URL. Leave unset on Vercel: it is derived automatically from the
# project's production domain (the *.vercel.app URL until a custom domain is
# attached, then the custom domain). Set it only to override that.
# NEXT_PUBLIC_SITE_URL=https://www.fawran.co

# GA4 / Firebase web measurement id (Firebase console > Project settings > your
# Web app > "measurementId"). Analytics stay off until this is set. Safe to expose.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification token (the content of the html-tag method's
# meta tag). Add once the real domain is verified; leave unset before then.
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Off-site profiles for this Fawran. An unrelated Saudi app shares the name, so
# these are the main way Google learns which entity this domain is: each one set
# here is emitted as schema.org `sameAs` and, for the stores, wires up the real
# download buttons. Set whichever exist; unset ones are simply omitted.
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/eg/app/...
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61593220870254
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fawrandelivery/
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/fawran-delivery

# Public Fawran API base, including the version prefix. Used by the contact form
# and by the receiver tracking page (/track/[token]), which also derives the
# socket.io origin from it by stripping the /api/v1 suffix — the same convention
# the mobile app uses. Defaults to the production backend when unset. Public by
# definition: only unauthenticated endpoints are ever called from the browser.
# NEXT_PUBLIC_API_URL=https://fawran-backend.onrender.com/api/v1

# MapTiler key for the live tracking map (cloud.maptiler.com > Keys). Optional:
# without it the map falls back to the keyless OpenFreeMap style, which is fine
# for development but should be replaced with a real key in production so tile
# delivery is under our own quota. Restrict the key to our domains in MapTiler.
# NEXT_PUBLIC_MAPTILER_KEY=xxxxxxxxxxxxxxxxxxxx

# Development-only tracking mock. Serves a scripted delivery instead of calling
# the backend, so the tracking page can be built before the public endpoint
# ships. Ignored entirely in production builds — see docs/public-tracking-contract.md.
# NEXT_PUBLIC_TRACKING_MOCK=1
